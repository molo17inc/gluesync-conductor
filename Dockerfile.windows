# escape=`

ARG WINDOWS_TAG=ltsc2019
ARG WINDOWS_VERSION=nanoserver
ARG WINDOWS_YEAR=2019

# Builder stage
FROM molo17/node:22.13.1-win-${WINDOWS_VERSION}-${WINDOWS_TAG} AS builder

WORKDIR C:\opt\gluesync-conductor

# Switch default shell to PowerShell 7 for builder stage
SHELL ["pwsh", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]

COPY . .
RUN yarn install --immutable --immutable-cache
RUN yarn build

# Final stage: runtime image
FROM molo17/node:22.13.1-win-${WINDOWS_VERSION}-${WINDOWS_TAG}

ARG WINDOWS_TAG
ARG WINDOWS_YEAR

WORKDIR C:\opt\gluesync-conductor

# Switch default shell to PowerShell 7 for runtime stage
SHELL ["pwsh", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop';"]

# Install Docker CLI + Compose + 7zip in one layer
RUN Invoke-WebRequest -Uri https://download.docker.com/win/static/stable/x86_64/docker-28.0.0.zip -OutFile C:/docker.zip -MaximumRetryCount 3 -RetryIntervalSec 5; `
  Invoke-WebRequest -Uri https://github.com/docker/compose/releases/download/v2.24.0/docker-compose-windows-x86_64.exe -OutFile C:/Windows/System32/docker-compose.exe -MaximumRetryCount 3 -RetryIntervalSec 5; `
  Invoke-WebRequest -Uri https://www.7-zip.org/a/7z2401-x64.msi -OutFile C:/7z.msi -MaximumRetryCount 3 -RetryIntervalSec 5; `
  # Extract Docker
  Expand-Archive -Path C:/docker.zip -DestinationPath C:/docker-temp; `
  Copy-Item 'C:/docker-temp/docker/docker.exe' 'C:/Windows/System32/docker.exe'; `
  # Install 7-zip via MSI and copy 7za.exe to zip.exe
  Start-Process -FilePath 'msiexec.exe' -ArgumentList '/i', 'C:\7z.msi', '/qn', '/norestart', 'INSTALLDIR=C:\7z' -Wait; `
  Copy-Item 'C:/7z/7za.exe' 'C:/Windows/System32/zip.exe'; `
  # Cleanup
  Remove-Item 'C:/docker.zip', 'C:/7z.msi', 'C:/docker-temp', 'C:/7z' -Recurse -Force

# Environment variables (one per line)
ENV NODE_ENV=production
ENV DKR_COMPOSE_FILE=C:\opt\gluesync-conductor\root-folder\docker-compose.yml
ENV DKR_COMPOSE_FILE_SOURCE=C:\opt\gluesync-conductor\root-folder\docker-compose.yml
ENV GLUESYNC_LICENSE_FILE=C:\opt\gluesync\data\gs-license.dat
ENV GLUESYNC_SECURITY_CONFIG=C:\opt\gluesync\data\security-config.json
ENV COREHUB_UDP_PORT_RANGE=1717-1727
ENV HOST=0.0.0.0
ENV PORT=1717
ENV DOCKER_HOST=npipe:////./pipe/docker_engine
ENV CORE_HUB_NAME=gluesync-core-hub
ENV LOG_LEVEL=INFO
ENV USE_SDK=true
ENV SSL_SKIP_VERIFY=true
ENV SSL_ENABLED=true
ENV SSL_CERT_FILE=C:\opt\gluesync\data\gluesync-cert.pem
ENV SSL_KEY_FILE=C:\opt\gluesync\data\gluesync-key.pem
ENV MOUNT_LEGACY_FILE_CONFIG=false
ENV GLUESYNC_CONFIG_DIR=.\shared
ENV IS_WINDOWS=true
ENV WINDOWS_YEAR=${WINDOWS_YEAR}
ENV HELPER_IMAGE_BASE=molo17/docker:28.0.0-win-nanoserver-${WINDOWS_TAG}

# Copy build artifacts
COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\build\index.js index.js
COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\build\index.js.map index.js.map
COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\agents.json agents.json
# Copy log collection scripts FROM build output
COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\build\collect-logs.ps1 collect-logs.ps1
COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\build\system-info.ps1 system-info.ps1
# Copy lmigration scripts FROM build output
COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\build\copy-agent-data.ps1 copy-agent-data.ps1

COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\public\gluesync-conductor.svg static\logo.svg
# COPY --from=builder C:\opt\gluesync-conductor\packages\gluesync-conductor\build\static\ static


EXPOSE 1717

CMD ["node","index.js"]
