{
  "name": "gluesync-nodejs-corehub-handshake-sdk",
  "version": "0.1.0",
  "description": "A Node.js client-side SDK for connecting to Gluesync CoreHub services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest tests/integration",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "example": "ts-node examples/example.ts"
  },
  "keywords": [
    "gluesync",
    "websocket",
    "nodejs",
    "sdk",
    "corehub"
  ],
  "author": "MOLO17 <info@molo17.com>",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/molo17/gluesync-nodejs-corehub-handshake-sdk"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "fs-extra": "^11.2.0",
    "jszip": "^3.10.1",
    "node-forge": "^1.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@types/node-forge": "^1.3.11",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
