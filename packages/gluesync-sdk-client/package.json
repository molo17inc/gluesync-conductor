{
  "name": "gluesync-sdk-client",
  "version": "1.0.0",
  "description": "Gluesync SDK integration for Container Mate",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/standalone.js",
  "scripts": {
    "format": "prettier --ignore-path ../.prettierignore .",
    "format:check": "yarn format --check",
    "format:write": "yarn format --write",
    "type-check": "yarn tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo",
    "build": "tsc",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "start": "node dist/standalone.js",
    "dev": "ts-node src/standalone.ts",
    "test": "jest"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "gluesync-sdk": "workspace:*",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@gluesync/scripts": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.14.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^gluesync-sdk$": "<rootDir>/src/__mocks__/gluesync-sdk.ts"
    }
  }
}
