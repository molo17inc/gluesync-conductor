{
  "swagger": "2.0",
  "info": {
    "title": "Gluesync Conductor API",
    "description": "API for managing Docker containers and agents",
    "version": "1.0.0"
  },
  "host": "localhost:50003",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [
    { "name": "agents", "description": "Agent management operations" },
    { "name": "containers", "description": "Container management operations" },
    { "name": "system", "description": "System operations" }
  ],
  "paths": {
    "/modules": {
      "post": {
        "tags": ["modules"],
        "summary": "Add one or more modules (containers tagged as modules)",
        "description": "Creates new containers with the type=module label via Compose.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Modules to add",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "modules": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Module" }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Modules added successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": { "$ref": "#/definitions/ComposeFile" }
              }
            }
          },
          "500": {
            "description": "Error response",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/agents": {
      "get": {
        "tags": ["agents"],
        "summary": "Get all agents (containers with type=source or type=target in environment)",
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Agent" }
                }
              }
            }
          },
          "500": {
            "description": "Error response",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/containers": {
      "get": {
        "tags": ["containers"],
        "summary": "List all containers",
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Container" }
                },
                "systemInfo": {
                  "type": "object",
                  "properties": {
                    "ncpu": { "type": "number" },
                    "memTotal": { "type": "number" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error response",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      },
      "post": {
        "tags": ["containers"],
        "summary": "Add new containers",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "agents": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Agent" }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          },
          "400": {
            "description": "Bad request",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Health check endpoint",
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          },
          "500": {
            "description": "Error response",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },

    "/containers/{id}": {
      "get": {
        "tags": ["containers"],
        "summary": "Get container by ID",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Container" }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      },
      "put": {
        "tags": ["containers"],
        "summary": "Update a container",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Container" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Container" }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      },
      "delete": {
        "tags": ["containers"],
        "summary": "Remove a container",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/containers/{id}/version": {
      "get": {
        "tags": ["containers"],
        "summary": "Get container version by ID",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": { "type": "string" }
              }
            }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/containers/{id}/start": {
      "post": {
        "tags": ["containers"],
        "summary": "Start a container",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/containers/{id}/pull": {
      "post": {
        "tags": ["containers"],
        "summary": "Pull the latest image for a container",
        "description": "Pulls the latest version of the image for the specified container",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "Container ID to pull image for"
          }
        ],
        "responses": {
          "200": {
            "description": "Image pulled successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          },
          "500": {
            "description": "Error response",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/containers/{id}/restart": {
      "post": {
        "tags": ["containers"],
        "summary": "Restart a container",
        "description": "Gracefully restarts the specified container with a timeout",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string",
            "description": "Container ID to restart"
          }
        ],
        "responses": {
          "200": {
            "description": "Container restarted successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          },
          "500": {
            "description": "Error response",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },
    "/containers/{id}/stop": {
      "post": {
        "tags": ["containers"],
        "summary": "Stop a container",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          },
          "404": {
            "description": "Container not found",
            "schema": { "$ref": "#/definitions/Error" }
          }
        }
      }
    },

    "/compose-to-json": {
      "get": {
        "tags": ["containers"],
        "summary": "Convert compose file to JSON",
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": ["system"],
        "summary": "Get system information",
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": ["system"],
        "summary": "Get API version",
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": { "$ref": "#/definitions/Success" }
          }
        }
      }
    }
  },
  "definitions": {
    "Module": {
      "type": "object",
      "properties": {
        "imageName": { "type": "string" },
        "type": { "type": "string" },
        "nickname": { "type": "string" },
        "tag": { "type": "string" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "ports": { "type": "array", "items": { "type": "string" } },
        "volumes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["imageName", "type"]
    },
    "Agent": {
      "type": "object",
      "required": ["imageName", "type"],
      "properties": {
        "imageName": {
          "type": "string",
          "description": "Name of the Docker image"
        },
        "type": {
          "type": "string",
          "enum": ["target", "source"],
          "description": "Type of the agent"
        },
        "nickname": {
          "type": "string",
          "description": "Optional nickname for the agent"
        },
        "tag": { "type": "string", "description": "Optional Docker image tag" },
        "environment": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional environment variables"
        },
        "ports": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional port mappings"
        },
        "volumes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional volume mappings"
        }
      }
    },
    "Container": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" },
        "tag": { "type": "string" },
        "versionTag": { "type": "string" },
        "persisted": { "type": "boolean" },
        "created": { "type": "string" },
        "running": { "type": "boolean" },
        "status": { "type": "string" },
        "exitCode": { "type": "number" },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" },
        "cmd": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "array", "items": { "type": "string" } },
        "labels": { "type": "object", "additionalProperties": true },
        "networkMode": { "type": "string" },
        "privileged": { "type": "boolean" },
        "ports": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "mounts": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "hostConfig": { "type": "object", "additionalProperties": true }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "default": false },
        "error": { "type": "string" }
      }
    },
    "Success": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean", "default": true },
        "data": { "type": "object" }
      }
    }
  }
}
