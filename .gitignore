# Yarn specific
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs
!.yarn/cache
# .pnp.*

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker related
.docker/data/
docker-compose.override.yml

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing & Logs
coverage/
logs/
*.log

# Swagger generated files
# Uncomment if you need to ignore specific swagger files
# packages/docker-mate/public/swagger.yaml

# Temporary files
temp/
tmp/
.temp/
.tmp/
gs-license.dat
