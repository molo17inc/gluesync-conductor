{
  "name": "gluesync-nodejs-monorepo",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier .",
    "format:check": "yarn format --check",
    "format:write": "yarn format --write",
    "build": "yarn workspaces run build",
    "start": "node packages/docker-mate/dist/index.js",
    "dev": "yarn workspace docker-mate dev",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.38",
    "@types/node": "^22.14.1",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "fastify": "5.2.1"
  }
}
