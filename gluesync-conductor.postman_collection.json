            "body": {
              "mode": "raw",
              "raw": "{\n  \"agents\": [\n    {\n      \"imageName\": \"gluesync-mssql-cdc\",\n      \"type\": \"target\",\n      \"environment\": {\n        \"NODE_ENV\": \"production forse\",\n        \"DB_HOST\": \"db\",\n        \"DB_USER\": \"root\",\n        \"DB_PASS\": \"password\",\n        \"privileged\": true,\n        \"start_from\": 0\n      },\n      \"labels\": {\n        \"test\": \"new label\"\n      }\n    },\n    {\n      \"imageName\": \"gluesync-mssql-cdc\",\n      \"type\": \"source\",\n      \"environment\": {\n        \"NODE_ENV\": \"development\",\n        \"DB_HOST\": \"dbaaa\",\n        \"DB_USER\": \"rooooooot\",\n        \"DB_PASS\": \"password\"\n      },\n      \"reservations\": {\n        \"cpus\": 1.0,\n        \"memory\": \"2.0G\"\n      },\n      \"limits\": {\n        \"cpus\": 2.0,\n        \"memory\": \"6.4G\"\n      }\n    },\n    {\n      \"imageName\": \"gluesync-aerospike\",\n      \"type\": \"target\",\n      \"nickname\": \"custom-aerospike-agt\",\n      \"ports\": [\"9090:9090\", \"9090:9091\", \"8080:80\"]\n    },\n    {\n      \"imageName\": \"gluesync-mssql-cdc\",\n      \"type\": \"source\",\n      \"environment\": {\n        \"DB_PASS\": \"new_password\"\n      },\n      \"reservations\": {\n        \"cpus\": 1.0,\n        \"memory\": \"2.3G\"\n      },\n      \"limits\": {\n        \"cpus\": 2.0,\n        \"memory\": \"6.8G\"\n      }\n    }\n  ]\n}\n",
              "options": {
                "raw": {
                  "language": "json"
